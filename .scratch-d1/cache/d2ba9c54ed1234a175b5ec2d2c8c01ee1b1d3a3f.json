e QTIP property.\" />\n<link rel=\"canonical\" href=\"https://www.maine.gov/revenue/taxes/income-estate-tax/estate-tax-706me\" />\n<meta name=\"Generator\" content=\"Drupal 10 (https://www.drupal.org)\" />\n<meta name=\"MobileOptimized\" content=\"width\" />\n<meta name=\"HandheldFriendly\" content=\"true\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<link rel=\"icon\" href=\"/revenue/sites/maine.gov.revenue/files/favicon.ico\" type=\"image/vnd.microsoft.icon\" />\n\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/libraries/drupal-superfish/css/superfish.css?tleo6e\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/core/modules/system/css/components/align.module.css?tleo6e\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/core/modules/system/css/components/fieldgroup.module.css?tleo6e\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/core/modules/system/css/components/container-inline.module.css?tleo6e\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/core/modules/system/css/components/clearfix.module.css?tleo6e\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/core/modules/system/css/components/details.module.css?tleo6e\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/core/modules/system/css/components/hidden.module.css?tleo6e\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/core/modules/system/css/components/item-list.module.css?tleo6e\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/core/modules/system/css/components/js.module.css?tleo6e\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/core/modules/system/css/components/nowrap.module.css?tleo6e\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/core/modules/system/css/components/position-container.module.css?tleo6e\" />\n<link rel=\"stylesheet\" media=\"all\" href=\"/revenue/core/modules/system/css/components/reset-appearance.module.css?tleo6e\" />\n<link rel